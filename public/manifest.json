{
    "name": "AsyncFetcher Beta",
    "version": "1.0",
    "description": "记录XHR/Fetch请求，集成AsyncTest分析、补充Api信息。",
    "manifest_version": 3,
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "css": ["content.css"],
        "js": ["content.js"],
        "run_at": "document_start"
      }
    ],
    "permissions": [
      "storage",
      "webRequest",
      "declarativeContent",
      "declarativeNetRequest",
      "declarativeNetRequestFeedback",
      "activeTab"],
    "host_permissions":["*://*/*"],
    "web_accessible_resources": [
      {
        "resources": [ "/images/app.png" ],
        "matches": ["<all_urls>"]
      },
      {
        "resources": [ "insert.js" ],
        "matches": ["<all_urls>"]
      }
    ],
    "action": {
      "default_popup": "index.html",
      "default_icon": {
        "16": "/images/app.png",
        "32": "/images/app.png",
        "48": "/images/app.png",
        "128": "/images/app.png"
      },
      "default_title": "AsyncPlugin"
    },
    "icons": {
      "16": "/images/app.png",
      "32": "/images/app.png",
      "48": "/images/app.png",
      "128": "/images/app.png"
    }
  }
  